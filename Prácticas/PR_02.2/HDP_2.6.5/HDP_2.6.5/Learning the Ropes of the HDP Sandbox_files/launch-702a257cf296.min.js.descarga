n\n\n\n//Send clicks to AA\nwindow.TrustArcTrack = function(action){\n  \n  if( document.querySelectorAll("button#truste-consent-required")[0] ){\n    region = "US West";\n  }\n  else{\n    region = "US East & India North";\n  }\n  \n  s.eVar180 = region;\n  \n  s.linkTrackVars="eVar180,event166,event167,event168,events";\n  s.linkTrackEvents = s.events;\n  \n  s.tl(true,"o",action);\n  s.clearVars();\n  \n}\n\n// Capture TrustArc banner clicks\ndocument.addEventListener(\'click\',function(event){\n  \n//-------\n//LEVEL 1 (banner)\n//-------\n\n  if(event.target.matches("button#truste-consent-button")){\n    window.TrustArcTrack("TrustArc: Accept All button");\n    s.events="event166";\n  }  \n\n  if(event.target.matches("button#truste-show-consent")){\n    window.TrustArcTrack("TrustArc: Manage your own preferences");\n    s.events="event168";\n  }\n\n  if(event.target.matches("button#truste-consent-required")){\n    window.TrustArcTrack("TrustArc: Opt Out Button");\n    s.events="event167";\n  }\n  \n  //--------------\n  //BEYOND LEVEL 1\n  //--------------\n  //In this rule there was previously logic to track other element -- but they were inside an iframe and therefore not trackabe.\n  //If for whatever reason you wish to view that event listener logic, view an older version of this rule.\n  \n});\n\n\n\n//For tracking the impression. Tried to put this on the pageview rule but there\'s a timing issue.\nvar pollTrustArcBanner = function(){\n  \n  if( document.querySelectorAll("#truste-consent-button")[0] ){ //Does the TrustArc banner exist? (based on the Accept button)\n    s.events="event165";\n    window.TrustArcTrack("TrustArc: Impression");\n  }\n  else{\n    setTimeout(pollTrustArcBanner,500)\n  }\n  \n}\npollTrustArcBanner();\n\n\n\n\n\n',language:"javascript"}}]},{id:"RL6febce3e465e44d5b0f027d9725e550a",name:"0_Pageview",events:[{modulePath:"data-layer-manager-search-discovery/src/lib/events/data_layer_push_event.js",settings:{eventType:"pageView",subscr